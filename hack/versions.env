# Pinned tool versions — the single source of truth, consumed three ways:
#   - shell:    `source hack/versions.env`        (hack/lib.sh, hack/e2e-microshift.sh)
#   - make:     `include ../hack/versions.env`     (operator/Makefile)
#   - workflows: `grep -v '^#' hack/versions.env >> "$GITHUB_ENV"`
# Keep lines as literal KEY=value (no spaces around =, no interpolation) so all three
# parsers accept the file. Bump a tool here and every consumer follows.
# A <TOOL>_SHA256 is the sha256 of the linux-amd64 file its consumer downloads and checks
# before use: bump it together with the version, taken from the publisher's checksums
# file (or the release API's asset digest where none is published), or the job fails.
# Release binaries, verified and cached by .github/actions/operator-tools.
OPERATOR_SDK_VERSION=v1.42.3
OPERATOR_SDK_SHA256=887a3bb0d63ccc4ca47a522d0c8ffac56d9d5246f6a2bd886b4ed23eb2e2672f
OPM_VERSION=v1.74.0
OPM_SHA256=cf1bd699be72e0a4511208afdf45444fc47d21eb2ffed0c204520ff50b5a4691
KIND_VERSION=v0.33.0
KIND_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
# No digest: `go run` checks modules against sum.golang.org, and OLM is fetched by
# `operator-sdk olm install`.
OLM_VERSION=0.46.0
OPERATOR_MANIFEST_TOOLS_VERSION=v0.12.0
YQ_VERSION=v4.54.1
TYGO_VERSION=v0.2.21
# Preloaded by .github/actions/olm-kind. The node image tracks the k8s minor
# OpenShift ships (4.22 = 1.35) and must be a digest from KIND_VERSION's release
# notes: kind node images are only guaranteed against the kind release that built them.
KIND_NODE_IMAGE=kindest/node:v1.35.8@sha256:07b2536e30b803ed61d1677a79df6115f798ce64c80f9e22f6ed45afd09323c0
GOLANGCI_LINT_VERSION=v2.15.0
# Operator envtest: setup-envtest (controller-runtime release-0.23) and the
# kube-apiserver + etcd it fetches.
SETUP_ENVTEST_VERSION=v0.0.0-20260305142021-f9589b9f2b9d
ENVTEST_K8S_VERSION=1.35.0
# Nightly + PR vulnerability scan (.github/workflows/vuln.yaml).
GOVULNCHECK_VERSION=v1.9.0
