# Pinned tool versions — the single source of truth, consumed three ways:
#   - shell:    `source hack/versions.env`        (hack/lib.sh, hack/e2e-microshift.sh)
#   - make:     `include ../hack/versions.env`     (operator/Makefile)
#   - workflows: `grep -v '^#' hack/versions.env >> "$GITHUB_ENV"`
# Keep lines as literal KEY=value (no spaces around =, no interpolation) so all three
# parsers accept the file. Bump a tool here and every consumer follows.
# A <NAME>_SHA256 is the sha256 of the file its consumer downloads (linux-amd64 for a
# binary) and checks before use: bump it together with the version, taken from the
# publisher's checksums file (or the release API's asset digest where none is
# published), or the job fails. Images are pinned the same way, by tag plus digest.
# Release downloads, verified and cached by .github/actions/tools.
OPERATOR_SDK_VERSION=v1.42.3
OPERATOR_SDK_SHA256=887a3bb0d63ccc4ca47a522d0c8ffac56d9d5246f6a2bd886b4ed23eb2e2672f
OPM_VERSION=v1.74.0
OPM_SHA256=cf1bd699be72e0a4511208afdf45444fc47d21eb2ffed0c204520ff50b5a4691
KIND_VERSION=v0.33.0
KIND_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
GOLANGCI_LINT_VERSION=v2.15.0
GOLANGCI_LINT_SHA256=9b7fe6a6bf6334b98decf8d86b11415ea7889afdabdd1959fdce23af2a9ebcea
# crds.yaml and olm.yaml of the OLM release (its checksums.txt covers only the archives).
OLM_VERSION=0.46.0
OLM_CRDS_SHA256=2ecd51a33dfa00a5abcae7bf47bcc4eea6c6d6b4212bb36d6b887aa6ef6d63c5
OLM_SHA256=3a6cd5caea67bedc11464ad443fa0826d3777d7f1b4f2dfa00766a739f2ab44c
# Operator envtest: the kube-apiserver + etcd archive. Locally, setup-envtest
# (controller-runtime release-0.23) fetches it through the index at ENVTEST_INDEX_COMMIT
# and checks the index's sha512.
ENVTEST_K8S_VERSION=1.35.0
ENVTEST_SHA256=5716719def14a3fec3ed285e5e8c4280e6268854039b5073a96e8c0adafb1c02
ENVTEST_INDEX_COMMIT=1031496fc98a4f51010c3bdfdeb57b5d67bea7bd
SETUP_ENVTEST_VERSION=v0.0.0-20260305142021-f9589b9f2b9d
# No digest: `go run` checks modules against sum.golang.org.
OPERATOR_MANIFEST_TOOLS_VERSION=v0.12.0
YQ_VERSION=v4.54.1
TYGO_VERSION=v0.2.21
# Preloaded by .github/actions/olm-kind. The node image tracks the k8s minor
# OpenShift ships (4.22 = 1.35) and must be a digest from KIND_VERSION's release
# notes: kind node images are only guaranteed against the kind release that built them.
KIND_NODE_IMAGE=kindest/node:v1.35.8@sha256:07b2536e30b803ed61d1677a79df6115f798ce64c80f9e22f6ed45afd09323c0
REGISTRY_IMAGE=docker.io/library/registry:2.8.3@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373
# Moves with OPERATOR_SDK_VERSION; operator/config/scorecard pins the same ref (CI validate checks).
SCORECARD_TEST_IMAGE=quay.io/operator-framework/scorecard-test:v1.42.3@sha256:2370b520e3ca95b25544191d618b8b7fbe5a7c438ed84f729351847aee0ca6ea
# Run by docker/setup-qemu-action (privileged) and docker/setup-buildx-action in the image jobs.
BINFMT_IMAGE=docker.io/tonistiigi/binfmt:qemu-v10.2.3-68@sha256:400a4873b838d1b89194d982c45e5fb3cda4593fbfd7e08a02e76b03b21166f0
BUILDKIT_IMAGE=docker.io/moby/buildkit:v0.34.2@sha256:c5f8862f52499773af85bc07695b2379ef08e8002352b0df2c4864c91d78dabe
# Nightly + PR vulnerability scan (.github/workflows/vuln.yaml).
GOVULNCHECK_VERSION=v1.9.0
# Real-loop installs (hack/e2e-microshift.sh).
ARGOCD_VERSION=v3.5.6
ARGOCD_INSTALL_SHA256=846c644bc81ce5557dd9048757a9c7353378f25c5eb811c77d32a9e907823599
KUBEVIRT_VERSION=v1.9.1
KUBEVIRT_OPERATOR_SHA256=9ac45a436c49d32e6fc21d542bcb7600b970705297b9e6752f3ef9b0a1d292da
