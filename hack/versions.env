# Pinned tool versions — the single source of truth, consumed three ways:
#   - shell:    `source hack/versions.env`        (hack/lib.sh)
#   - make:     `include ../hack/versions.env`     (operator/Makefile)
#   - workflows: `grep -v '^#' hack/versions.env >> "$GITHUB_ENV"`
# Keep lines as literal KEY=value (no spaces around =, no interpolation) so all three
# parsers accept the file. Bump a tool here and every consumer follows.
OPERATOR_SDK_VERSION=v1.42.3
OPM_VERSION=v1.74.0
OLM_VERSION=0.46.0
KIND_VERSION=v0.33.0
OPERATOR_MANIFEST_TOOLS_VERSION=v0.12.0
YQ_VERSION=v4.54.1
TYGO_VERSION=v0.2.21
# Preloaded by .github/actions/olm-kind. The node image tracks the k8s minor
# OpenShift ships (4.22 = 1.35) and must be a digest from KIND_VERSION's release
# notes: kind node images are only guaranteed against the kind release that built them.
KIND_NODE_IMAGE=kindest/node:v1.35.8@sha256:07b2536e30b803ed61d1677a79df6115f798ce64c80f9e22f6ed45afd09323c0
GOLANGCI_LINT_VERSION=v2.14.0
# Operator envtest: setup-envtest (controller-runtime release-0.22) and the
# kube-apiserver + etcd it fetches.
SETUP_ENVTEST_VERSION=v0.0.0-20260125163108-a19ec76a3c5d
ENVTEST_K8S_VERSION=1.34.1
