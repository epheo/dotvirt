{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write src",
		"format:check": "prettier --check src",
		"lint": "eslint . && knip",
		"test:unit": "vitest run",
		"test:ui": "npm run build && playwright test -c playwright.fixture.config.ts",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.0",
		"knip": "^6.45.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"ws": "^8.23.0"
	},
	"dependencies": {
		"@fontsource/red-hat-mono": "^5.3.0",
		"@fontsource/red-hat-text": "^5.3.0",
		"@lucide/svelte": "^1.72.0",
		"@novnc/novnc": "^1.7.0",
		"uplot": "^1.6.32"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"minimatch": "^11.0.3"
	}
}
