name: web-02
namespace: tenant-a
message: 
---
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: web-02
  namespace: tenant-a
spec:
  dataVolumeTemplates:
  - metadata:
      name: web-02-rootdisk
    spec:
      sourceRef:
        kind: DataSource
        name: fedora
        namespace: images
      storage:
        resources:
          requests:
            storage: 30Gi
  instancetype:
    name: u1.medium
  preference:
    name: fedora
  runStrategy: Halted
  template:
    metadata: {}
    spec:
      domain:
        devices:
          disks:
          - disk:
              bus: virtio
            name: rootdisk
          interfaces:
          - masquerade: {}
            name: default
          - bridge: {}
            name: vm-net
          - bridge: {}
            name: shared
        resources: {}
      networks:
      - name: default
        pod: {}
      - multus:
          networkName: vm-net
        name: vm-net
      - multus:
          networkName: openshift-cnv/shared
        name: shared
      volumes:
      - dataVolume:
          name: web-02-rootdisk
        name: rootdisk
